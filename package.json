{
  "name": "resttek",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @resttek/api",
    "dev:admin": "npm run start -w @resttek/web-admin",
    "dev:empleados": "npm run start -w @resttek/web-empleados",
    "dev:clientes": "npm run start -w @resttek/web-clientes",
    "test": "npm run test -w @resttek/api && npm run test -w @resttek/web-admin && npm run test -w @resttek/web-empleados && npm run test -w @resttek/web-clientes",
    "seed": "npm run seed -w @resttek/api",
    "test:admin": "npm run test -w @resttek/web-admin",
    "e2e": "npm run e2e -w @resttek/web-admin",
    "e2e:video": "npm run e2e:video -w @resttek/web-admin"
  }
}
